# Copy this file to .env and fill it in. .env is git-ignored — never commit it.

# Telegram: a NEW bot made just for this project (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Your own chat id. Leave empty, message the bot, and it will tell you.
TELEGRAM_CHAT_ID=

# AI writer: Gemini first, Groq as backup. Both have free tiers. If both fail a plain template is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub token so commits from your repos can be read (fine-grained, read-only "Contents" is enough).
# Optional for public repos, required for private ones.
GH_TOKEN=

# Bluesky: your handle (e.g. you.bsky.social) and an APP password (Settings -> Privacy and security -> App passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# 1 = approving a draft does NOT really post (safe testing). Set to 0 when you're ready to go public.
BLUESKY_DRY_RUN=1
